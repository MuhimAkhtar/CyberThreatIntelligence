# Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to git — only .env.example

# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyber_threat_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cyber_threat_platform

# ── Redis ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── API ───────────────────────────────────────────
API_PORT=3000
API_PREFIX=api/v1
NODE_ENV=development

# ── Frontend ──────────────────────────────────────
VITE_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# ── Kafka (Phase 2+) ─────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── Elasticsearch (Phase 2+) ─────────────────────
ELASTICSEARCH_NODE=http://localhost:9200

# ── NVD — National Vulnerability Database (Phase 2+)
# Get a free key at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ── AlienVault OTX (Phase 2+) ────────────────────
# Get a free key at https://otx.alienvault.com/api
OTX_API_KEY=

# ── MISP (Phase 2+) ──────────────────────────────
# Self-hosted via infra/misp/ — see docs/decisions.md
MISP_BASE_URL=http://localhost:8443
MISP_API_KEY=

# ── Feed Scheduler ───────────────────────────────
FEED_SYNC_ENABLED=false
